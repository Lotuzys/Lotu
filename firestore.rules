rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'eima.lotuzys@gmail.com';
    }

    // ── Round deadlines ──────────────────────────────────────────────────
    // Each round is played on one Sunday; deadline is 13:30 EEST (10:30 UTC,
    // i.e. +630 minutes past midnight UTC) that day. PLACEHOLDER dates —
    // weekly Sundays through winter 2026/27, stand-in until the real
    // vilniausfutbolas.lt schedule is available. Must match FR[i].days[0].date
    // in sfl-fantasy-v2.html exactly — update both together.
    function DEADLINES() {
      return {
        '0':  timestamp.date(2026, 12, 6)  + duration.value(630, 'm'),
        '1':  timestamp.date(2026, 12, 13) + duration.value(630, 'm'),
        '2':  timestamp.date(2026, 12, 20) + duration.value(630, 'm'),
        '3':  timestamp.date(2026, 12, 27) + duration.value(630, 'm'),
        '4':  timestamp.date(2027, 1, 3)   + duration.value(630, 'm'),
        '5':  timestamp.date(2027, 1, 10)  + duration.value(630, 'm'),
        '6':  timestamp.date(2027, 1, 17)  + duration.value(630, 'm'),
        '7':  timestamp.date(2027, 1, 24)  + duration.value(630, 'm'),
        '8':  timestamp.date(2027, 1, 31)  + duration.value(630, 'm'),
        '9':  timestamp.date(2027, 2, 7)   + duration.value(630, 'm'),
        '10': timestamp.date(2027, 2, 14)  + duration.value(630, 'm'),
      };
    }

    // ── Per-user squad/points integrity ─────────────────────────────────
    // These only run on UPDATE (the doc already exists) — the very first
    // write, at onboarding, is a plain `create` with no history to protect.

    // Once a round's score exists, it can never be changed by a later write.
    function roundPtsLocked(key) {
      let before = resource.data.get('myRoundPts', {});
      let after  = request.resource.data.get('myRoundPts', {});
      return !(key in before) || (key in after && after[key] == before[key]);
    }

    // A round's locked-in squad snapshot can only be created or changed
    // before that round's deadline; after the deadline it's frozen.
    function roundSquadOk(key) {
      let beforeSquads = resource.data.get('mySquads', {});
      let afterSquads  = request.resource.data.get('mySquads', {});
      let beforeHas = key in beforeSquads;
      let afterHas  = key in afterSquads;
      let unchanged = beforeHas == afterHas && (!beforeHas || afterSquads[key] == beforeSquads[key]);
      return unchanged || request.time < DEADLINES()[key];
    }

    function newPts(key, before, after) {
      return (!(key in before) && (key in after)) ? after[key] : 0;
    }
    function newCount(key, before, after) {
      return (!(key in before) && (key in after)) ? 1 : 0;
    }

    // myTotalPts/myRoundsPlayed can only move by exactly one newly-added
    // round's worth per write — never set directly to an arbitrary number,
    // and never for more than one round at a time (matches how the app
    // actually plays: calcMyPts() finalizes one round at a time).
    function totalsConsistent() {
      let beforeRP = resource.data.get('myRoundPts', {});
      let afterRP  = request.resource.data.get('myRoundPts', {});
      let sumNew = newPts('0',beforeRP,afterRP) + newPts('1',beforeRP,afterRP) + newPts('2',beforeRP,afterRP) +
                   newPts('3',beforeRP,afterRP) + newPts('4',beforeRP,afterRP) + newPts('5',beforeRP,afterRP) +
                   newPts('6',beforeRP,afterRP) + newPts('7',beforeRP,afterRP) + newPts('8',beforeRP,afterRP) +
                   newPts('9',beforeRP,afterRP) + newPts('10',beforeRP,afterRP);
      let cntNew = newCount('0',beforeRP,afterRP) + newCount('1',beforeRP,afterRP) + newCount('2',beforeRP,afterRP) +
                   newCount('3',beforeRP,afterRP) + newCount('4',beforeRP,afterRP) + newCount('5',beforeRP,afterRP) +
                   newCount('6',beforeRP,afterRP) + newCount('7',beforeRP,afterRP) + newCount('8',beforeRP,afterRP) +
                   newCount('9',beforeRP,afterRP) + newCount('10',beforeRP,afterRP);
      return cntNew <= 1
        && request.resource.data.get('myTotalPts', 0) == resource.data.get('myTotalPts', 0) + sumNew
        && request.resource.data.get('myRoundsPlayed', 0) == resource.data.get('myRoundsPlayed', 0) + cntNew;
    }

    function squadStateValid() {
      return roundPtsLocked('0') && roundPtsLocked('1') && roundPtsLocked('2') && roundPtsLocked('3') &&
             roundPtsLocked('4') && roundPtsLocked('5') && roundPtsLocked('6') && roundPtsLocked('7') &&
             roundPtsLocked('8') && roundPtsLocked('9') && roundPtsLocked('10') &&
             roundSquadOk('0') && roundSquadOk('1') && roundSquadOk('2') && roundSquadOk('3') &&
             roundSquadOk('4') && roundSquadOk('5') && roundSquadOk('6') && roundSquadOk('7') &&
             roundSquadOk('8') && roundSquadOk('9') && roundSquadOk('10') &&
             totalsConsistent();
    }

    // Each player's own squad/points. Everyone signed in can read (needed for
    // the leaderboard and rank). Writing your own doc is allowed, but past
    // rounds' scores and squads are frozen, and totals can't be forged.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid && squadStateValid();
    }

    // Match results, goalscorers and league standings — shared by everyone,
    // only the admin account can write.
    match /league/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
