rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'eima.lotuzys@gmail.com';
    }

    // ── Round deadlines ──────────────────────────────────────────────────
    // Each round is played on one day; deadline is 13:30 EEST (10:30 UTC,
    // i.e. +630 minutes past midnight UTC) that day. Every even day of
    // August 2026 starting the 4th. Must match FR[i].days[0].date in
    // sfl-fantasy-v2.html exactly — update both together.
    function DEADLINES() {
      return {
        '0':  timestamp.date(2026, 8, 4)  + duration.value(630, 'm'),
        '1':  timestamp.date(2026, 8, 6)  + duration.value(630, 'm'),
        '2':  timestamp.date(2026, 8, 8)  + duration.value(630, 'm'),
        '3':  timestamp.date(2026, 8, 10) + duration.value(630, 'm'),
        '4':  timestamp.date(2026, 8, 12) + duration.value(630, 'm'),
        '5':  timestamp.date(2026, 8, 14) + duration.value(630, 'm'),
        '6':  timestamp.date(2026, 8, 16) + duration.value(630, 'm'),
        '7':  timestamp.date(2026, 8, 18) + duration.value(630, 'm'),
        '8':  timestamp.date(2026, 8, 20) + duration.value(630, 'm'),
        '9':  timestamp.date(2026, 8, 22) + duration.value(630, 'm'),
        '10': timestamp.date(2026, 8, 24) + duration.value(630, 'm'),
      };
    }

    // ── Trusted player data ─────────────────────────────────────────────
    // meta/players holds a copy of sfl-fantasy-v2.html's PLAYERS array
    // (position/team/price only, indexed 0..n-1 for ids 1..n — array order
    // IS the id, no string-keyed lookup needed) so squad legality can be
    // checked against real data instead of whatever a client write claims.
    // Synced automatically whenever the admin logs in (syncPlayerIndex() in
    // the app) — admin-write-only, never touched by regular players.
    function playerIndex() {
      return get(/databases/$(database)/documents/meta/players).data.list;
    }
    function playerAt(idx, id) {
      return idx[id - 1];
    }

    // ── Per-user squad integrity ─────────────────────────────────────────
    // Points are never stored — the client always derives them from a
    // round's frozen squad snapshot (mySquads) plus the shared match-results
    // doc (admin-only-writable), recomputed fresh on every read. So what's
    // worth protecting here is the squad snapshot itself: it must be a
    // legal squad (7 correctly-positioned real players, one per club, within
    // budget) whenever it's created or changed, and frozen once that
    // round's deadline passes. This runs only on UPDATE — the very first
    // write, at onboarding, is a plain `create` with no history to protect.

    // A single slot must be a real player (checked against the trusted
    // index by id, not by trusting the pos/team/price the client submitted
    // alongside it) whose recorded position matches this slot.
    function slotValid(p, pos, idx) {
      return p != null && ('id' in p) && p.id >= 1 && p.id <= idx.size() && playerAt(idx, p.id).pos == pos;
    }

    // Firestore rules cap each function at 10 local variables, so the
    // legality check is split into several small functions on a 7-element
    // list [G, D, D, M, M, F, F] instead of one function with a named
    // variable per slot.
    function squadSlots(snap) {
      let gk = snap.slots.G; let df = snap.slots.D; let mf = snap.slots.M; let fw = snap.slots.F;
      let shapeOk = gk.size()==1 && df.size()==2 && mf.size()==2 && fw.size()==2;
      return shapeOk ? [gk[0], df[0], df[1], mf[0], mf[1], fw[0], fw[1]] : [];
    }
    function slotsValid(s, idx) {
      return s.size()==7
        && slotValid(s[0],'G',idx) && slotValid(s[1],'D',idx) && slotValid(s[2],'D',idx)
        && slotValid(s[3],'M',idx) && slotValid(s[4],'M',idx) && slotValid(s[5],'F',idx) && slotValid(s[6],'F',idx);
    }
    function slotTeams(s, idx) {
      return [playerAt(idx,s[0].id).team, playerAt(idx,s[1].id).team, playerAt(idx,s[2].id).team,
              playerAt(idx,s[3].id).team, playerAt(idx,s[4].id).team, playerAt(idx,s[5].id).team,
              playerAt(idx,s[6].id).team];
    }
    // One player per club — 7 pairwise distinctness checks (no set type
    // available here, so this is spelled out rather than deduced).
    function teamsDistinct(t) {
      return t[0]!=t[1] && t[0]!=t[2] && t[0]!=t[3] && t[0]!=t[4] && t[0]!=t[5] && t[0]!=t[6]
        && t[1]!=t[2] && t[1]!=t[3] && t[1]!=t[4] && t[1]!=t[5] && t[1]!=t[6]
        && t[2]!=t[3] && t[2]!=t[4] && t[2]!=t[5] && t[2]!=t[6]
        && t[3]!=t[4] && t[3]!=t[5] && t[3]!=t[6]
        && t[4]!=t[5] && t[4]!=t[6]
        && t[5]!=t[6];
    }
    function squadBudget(s, idx) {
      return playerAt(idx,s[0].id).price + playerAt(idx,s[1].id).price + playerAt(idx,s[2].id).price
        + playerAt(idx,s[3].id).price + playerAt(idx,s[4].id).price + playerAt(idx,s[5].id).price
        + playerAt(idx,s[6].id).price;
    }
    function squadLegal(snap) {
      let idx = playerIndex();
      let s = squadSlots(snap);
      return s.size()==7
        && slotsValid(s, idx)
        && teamsDistinct(slotTeams(s, idx))
        && squadBudget(s, idx) <= 50.01;
    }

    function roundSquadOk(key) {
      let beforeSquads = resource.data.get('mySquads', {});
      let afterSquads  = request.resource.data.get('mySquads', {});
      let beforeHas = key in beforeSquads;
      let afterHas  = key in afterSquads;
      let unchanged = beforeHas == afterHas && (!beforeHas || afterSquads[key] == beforeSquads[key]);
      let beforeDeadline = request.time < DEADLINES()[key];
      return unchanged
        || (beforeDeadline && !afterHas)
        || (beforeDeadline && afterHas && squadLegal(afterSquads[key]));
    }

    function squadStateValid() {
      return roundSquadOk('0') && roundSquadOk('1') && roundSquadOk('2') && roundSquadOk('3') &&
             roundSquadOk('4') && roundSquadOk('5') && roundSquadOk('6') && roundSquadOk('7') &&
             roundSquadOk('8') && roundSquadOk('9') && roundSquadOk('10');
    }

    // Each player's own squad. Everyone signed in can read (needed for the
    // leaderboard — every viewer recomputes every user's points client-side
    // from this plus the shared results doc). Writing your own doc is
    // allowed, but a submitted/changed squad must be legal, and it's frozen
    // once that round's deadline passes.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid && squadStateValid();
    }

    // Match results, goalscorers and league standings — shared by everyone,
    // only the admin account can write.
    match /league/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Trusted player position/team/price index — see playerIndex() above.
    match /meta/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
