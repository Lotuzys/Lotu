rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'eima.lotuzys@gmail.com';
    }

    // Each player's own squad/points. Everyone signed in can read (needed for
    // the leaderboard and rank), but a user can only write their own document.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Match results, goalscorers and league standings — shared by everyone,
    // only the admin account can write.
    match /league/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
